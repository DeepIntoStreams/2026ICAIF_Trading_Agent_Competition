POSTGRES_DB=competition
POSTGRES_USER=competition
POSTGRES_PASSWORD=replace-for-nonlocal-use
POSTGRES_PORT=5432
COMPETITION_DATABASE_URL=postgresql://competition:replace-for-nonlocal-use@postgres:5432/competition
COMPETITION_ADMIN_TOKEN=replace-with-a-high-entropy-organizer-token
COMPETITION_RUN_ID=official_2026
COMPETITION_SUPPORTED_PROTOCOL_VERSIONS=0.1
COMPETITION_MAX_REQUEST_BYTES=65536
COMPETITION_BODY_READ_TIMEOUT_SECONDS=10
COMPETITION_MAX_INFLIGHT_DECISIONS=256
COMPETITION_INTAKE_DB_WORKERS=24
COMPETITION_API_REQUESTS_PER_MINUTE=120
COMPETITION_DECISION_REQUESTS_PER_MINUTE=30
COMPETITION_IP_REQUESTS_PER_MINUTE=600
COMPETITION_DB_CONNECT_TIMEOUT_SECONDS=3
COMPETITION_DB_STATEMENT_TIMEOUT_MS=5000
COMPETITION_DB_LOCK_TIMEOUT_MS=2000
COMPETITION_PORT=8080
MARKET_DATA_MIN_SOURCES=2
MASSIVE_API_KEY=replace-with-a-massive-market-data-api-key
TWELVE_DATA_API_KEY=replace-with-a-twelve-data-api-key
