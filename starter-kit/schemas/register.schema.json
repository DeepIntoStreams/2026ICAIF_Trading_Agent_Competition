{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Team registration",
  "required": [
    "submission_type",
    "team_name",
    "team_members",
    "contact_email"
  ],
  "properties": {
    "submission_type": {
      "const": "register"
    },
    "team_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "team_members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "institution"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "format": "email",
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
          },
          "institution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        }
      }
    },
    "contact_email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320,
      "format": "email",
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
    }
  }
}
