{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Final materials manifest",
  "required": [
    "submission_type",
    "team_id",
    "team_token",
    "team_members",
    "materials_url",
    "materials"
  ],
  "properties": {
    "submission_type": {
      "const": "final_submission"
    },
    "team_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "team_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S",
      "writeOnly": true
    },
    "team_members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "institution"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "format": "email",
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
          },
          "institution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          }
        }
      }
    },
    "materials_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "format": "uri",
      "pattern": "^https://[^/@\\s]+(?:[/?#][^\\s]*)?$"
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192,
        "pattern": "\\S"
      }
    }
  }
}
