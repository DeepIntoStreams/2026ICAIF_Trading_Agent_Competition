{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Trading decision for the official 30-stock universe",
  "description": "Validate exact decimals locally. Total weight must be <= 1 + 1e-10; the backend corrects tolerated excess. All symbols are mandatory. Round windows require the selected schedule.",
  "required": [
    "submission_type",
    "team_id",
    "team_token",
    "phase",
    "round_id",
    "weights"
  ],
  "properties": {
    "submission_type": {
      "const": "decision"
    },
    "team_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "team_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S",
      "writeOnly": true
    },
    "phase": {
      "enum": [
        "validation",
        "official"
      ]
    },
    "round_id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(validation|official)-[0-9]{4}-[0-9]{2}-[0-9]{2}-r[1-7]$"
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 30,
      "maxProperties": 30,
      "required": [
        "AAPL",
        "MSFT",
        "NVDA",
        "INTC",
        "CRM",
        "JPM",
        "BAC",
        "GS",
        "V",
        "PYPL",
        "LLY",
        "JNJ",
        "UNH",
        "PFE",
        "TMO",
        "AMZN",
        "TSLA",
        "WMT",
        "NKE",
        "KO",
        "CAT",
        "GE",
        "BA",
        "XOM",
        "CVX",
        "GOOGL",
        "META",
        "DIS",
        "T",
        "NEE"
      ],
      "properties": {
        "AAPL": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "MSFT": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "NVDA": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3
        },
        "INTC": {
          "type": "number",
          "minimum": 0,
