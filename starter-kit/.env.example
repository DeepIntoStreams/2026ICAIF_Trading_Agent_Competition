# Copy to .env; keep it private and never upload it.
# Personal Codabench API token: native upload and your platform receipts.
CODABENCH_TOKEN=
# Path to the actual profile issued by the organizer; no competition ID is guessed.
ICAIF_PROFILE=
# Optional original manual-tool configuration.
# The automatic client normally obtains TEAM_ID/TEAM_TOKEN once at registration
# and saves them in .icaif/credentials.json (0600).
TRADING_API_BASE_URL=
TEAM_ID=
TEAM_TOKEN=
# Example watch strategy: point this to your own locally computed round weights.
ICAIF_WEIGHTS_FILE=
