{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icaif2026.example/portfolio_agent/observation_without_news.schema.json",
  "title": "ObservationWithoutNews",
  "description": "Agent-visible observation, no-news variant. Identical to observation_with_news except `news` MUST be an empty array (kept in-schema for stability so participant code paths do not branch on presence).",
  "type": "object",
  "required": ["session_date", "event_time_utc", "assets", "market_features", "fundamental_features", "portfolio", "constraints", "news"],
  "additionalProperties": false,
  "$defs": {
    "featureMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {"type": ["number", "boolean", "null"]}
      }
    }
  },
  "properties": {
    "session_date": {"type": "string", "format": "date"},
    "event_time_utc": {"type": "string", "format": "date-time"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ticker", "company_name", "sector", "open_price"],
        "additionalProperties": true,
        "properties": {
          "ticker": {"type": "string"},
          "company_name": {"type": "string"},
          "sector": {"type": "string"},
          "open_price": {"type": ["number", "null"]}
        }
      }
    },
    "market_features": {"$ref": "#/$defs/featureMap"},
    "fundamental_features": {"$ref": "#/$defs/featureMap"},
    "portfolio": {
      "type": "object",
      "required": ["weights", "cash_ratio", "nav"],
      "additionalProperties": true,
      "properties": {
        "weights": {"type": "object", "additionalProperties": {"type": "number"}},
        "cash_ratio": {"type": "number"},
        "nav": {"type": "number", "minimum": 0}
      }
    },
    "constraints": {
      "type": "object",
      "required": ["long_only", "max_asset_weight", "max_gross_exposure"],
      "additionalProperties": true,
      "properties": {
        "long_only": {"type": "boolean"},
        "max_asset_weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "max_gross_exposure": {"type": "number", "exclusiveMinimum": 0},
        "fee_rate": {"type": "number", "minimum": 0},
        "slippage_bps": {"type": "number", "minimum": 0}
      }
    },
    "news": {"type": "array", "maxItems": 0}
  }
}
